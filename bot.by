import time
import telebot
from google import genai
from google.genai import types

# Токен вашего Telegram-бота
TELEGRAM_TOKEN = '8685192971:AAHOXk9CDUeDUnB4PefV_I7RVM_u6QnryW0'

# Ваш бесплатный API-ключ от Google Gemini
GEMINI_API_KEY = 'AQ.Ab8RN6KB6VOS4hOQbMqZI2ChJPke5ic0EQDoUgf9NBhot687pQ'

bot = telebot.TeleBot(TELEGRAM_TOKEN)
client = genai.Client(api_key=GEMINI_API_KEY)

# Хранилище сессий чатов для каждого пользователя
user_chats = {}

SYSTEM_INSTRUCTION = (
    "Ты — быстрый, эрудированный ИИ-помощник. Отвечай на русском языке очень кратко, емко и по делу. "
    "Твоего создателя и разработчика зовут Тим, его юзернейм в Telegram: @bubxb. "
    "Пользователь может делать опечатки или писать сленгом — всегда сам догадывайся о реальном смысле его слов и не заостряй на них внимание."
)

@bot.message_handler(commands=['start', 'help'])
def send_welcome(message):
    user_id = message.from_user.id
    # Используем актуальную модель gemini-3.6-flash
    user_chats[user_id] = client.chats.create(
        model="gemini-3.6-flash",
        config=types.GenerateContentConfig(
            system_instruction=SYSTEM_INSTRUCTION,
            max_output_tokens=300
        )
    )
    
    welcome_text = (
        "🤖 Привет, Тим! Бот успешно работает на **Google Gemini**.\n"
        "👨‍💻 **Создатель:** @bubxb\n\n"
        "Всё настроено! Спрашивай о чем угодно."
    )
    bot.reply_to(message, welcome_text, parse_mode="Markdown")

@bot.message_handler(func=lambda message: True)
def handle_ai_message(message):
    user_id = message.from_user.id
    user_text = message.text
    
    if user_id not in user_chats:
        user_chats[user_id] = client.chats.create(
            model="gemini-3.6-flash",
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                max_output_tokens=300
            )
        )

    waiting_msg = bot.reply_to(message, "⏳ Думаю...")

    try:
        response = user_chats[user_id].send_message(user_text)
        ai_answer = response.text

        bot.edit_message_text(
            chat_id=message.chat.id,
            message_id=waiting_msg.message_id,
            text=ai_answer
        )
    except Exception as e:
        bot.edit_message_text(
            chat_id=message.chat.id,
            message_id=waiting_msg.message_id,
            text=f"⚠️ Ошибка: {e}"
        )

if __name__ == '__main__':
    print("🚀 Запуск бота на Gemini API...")
    while True:
        try:
            bot.infinity_polling(timeout=30, long_polling_timeout=15)
        except Exception as e:
            print(f"⚠️ Ошибка связи: {e}. Переподключение...")
            time.sleep(5)